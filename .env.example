# Copy to .env and fill in. .env is gitignored.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional: only if you enable an authenticator app on Robinhood (lets logins run unattended)
ROBINHOOD_TOTP_SECRET=

# Stage 2 news (all optional; Yahoo headlines work without any key)
FINNHUB_API_KEY=          # https://finnhub.io/register (free, 60 calls/min)
ALPHAVANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key (free, 25 calls/day)
SEC_USER_AGENT=           # "Your Name you@example.com": SEC requires a contact in the User-Agent

# Optional: LLM sentiment via the Claude API
ANTHROPIC_API_KEY=
