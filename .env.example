# Copy to .env and fill in. .env is gitignored.
# Keep comments on their own lines: a comment after an empty value is read as the value.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional: only if your account has authenticator-app 2FA (no login approvals needed then)
ROBINHOOD_TOTP_SECRET=

# Stage 2 news (all optional; Yahoo headlines work without any key)
# https://finnhub.io/register (free, 60 calls/min)
FINNHUB_API_KEY=
# https://www.alphavantage.co/support/#api-key (free, 25 calls/day)
ALPHAVANTAGE_API_KEY=
# "Your Name you@example.com": SEC requires a contact in the User-Agent
SEC_USER_AGENT=

# Optional: LLM sentiment via the Claude API
ANTHROPIC_API_KEY=

# Notifications (optional; pick channels under `notify` in configs/settings.yaml)
# ntfy: a long random topic name, then subscribe to it in the ntfy app
NTFY_TOPIC=
# Only for a self-hosted or reserved ntfy topic
NTFY_TOKEN=
# Email, e.g. you@gmail.com. Gmail needs an app password: https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME
NOTIFY_EMAIL_TO=
