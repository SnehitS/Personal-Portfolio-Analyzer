# Copy to .env and fill in. .env is gitignored.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional: only if you enable an authenticator app on Robinhood (lets logins run unattended)
ROBINHOOD_TOTP_SECRET=

# Stage 2 news (all optional; Yahoo headlines work without any key)
FINNHUB_API_KEY=          # https://finnhub.io/register (free, 60 calls/min)
ALPHAVANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key (free, 25 calls/day)
SEC_USER_AGENT=           # "Your Name you@example.com": SEC requires a contact in the User-Agent

# Optional: LLM sentiment via the Claude API
ANTHROPIC_API_KEY=

# Notifications (optional; pick channels under `notify` in configs/settings.yaml)
NTFY_TOPIC=               # ntfy: a long random topic name, then subscribe to it in the ntfy app
NTFY_TOKEN=               # only for a self-hosted or reserved ntfy topic
SMTP_USERNAME=            # email: e.g. you@gmail.com
SMTP_PASSWORD=            # Gmail needs an app password: https://myaccount.google.com/apppasswords
NOTIFY_EMAIL_TO=          # defaults to SMTP_USERNAME
